# === 可选：SQLite（默认 ./data/token-tracker.db）===
SQLITE_DATABASE_PATH="./data/token-tracker.db"

# === 生产必需；本地 npm run dev 缺失时自动生成 <db 目录>/.gateway-secret（权限 600）===
# 已有数据库时必须保留/恢复原密钥：文件丢失后 dev 会拒绝启动（生成新密钥会使
# 库中已加密的 upstream key / 虚拟 key / 同步 token 永久不可解）
GATEWAY_SECRET=""            # openssl rand -hex 32

# === 可选：bootstrap ===
# ADMIN_API_KEY 未配置且 DB 无 key 时，Web 端会出现首次设置向导
# 强度仅由前端提示；个人/家庭部署允许弱 key，生产建议 openssl rand -hex 24
# 已配置弱 key 也不会把首次设置向导重新打开
# ADMIN_API_KEY="your-key"   # 旧名 API_KEYS 仍兼容（deprecated）

# === 可选：也可在 admin panel 配置（面板优先，env 仅 fallback） ===
# SESSION_TOKEN_TTL_HOURS=24

# === 可选：安全 ===
# 默认 false（fail-closed）。仅当前置反代已设置 X-Real-IP 并覆盖客户端 XFF 时设为 true，
# 否则登录/设置限流退化为全局桶（防 XFF 伪造绕过），审计 IP 记为 unknown。
# TRUSTED_PROXY=false

# === 可选：relay（sub node）——这些 env 只属于 relay 镜像，中心不要配 ===
# CENTER_URL="http://token-tracker:3000"   # relay 必填；非环回主机必须 https
# RELAY_DEVICE_NAME="laptop"                # Admin → Devices 展示名
# RELAY_PAIR_PAGE="local"                   # local（默认，仅环回/私网）| off | on
# RELAY_STATE_PATH="./data/relay.state.json" # 0600，唯一落盘文件（配对状态）
# 注：relay 进程里出现 SQLITE_DATABASE_PATH / ADMIN_API_KEY / LOCAL_ADMIN_BYPASS /
# GATEWAY_SECRET 会直接拒绝启动（防误拉中心镜像）
