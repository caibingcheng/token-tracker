# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# API Keys (comma separated)
API_KEYS="your-api-key-here"

# Provider Anonymization
# Legacy format (exact match, comma-separated):
#   HIDDEN_PROVIDERS="openai,anthropic"
# Grouped format (wildcard match, semicolon-separated groups):
#   HIDDEN_PROVIDERS="name1*,name2*;name3,name4*"
#   - Semicolons separate anonymous groups (Provider A, B, C...)
#   - Commas separate patterns within a group
#   - Asterisk suffix means prefix match
#   - Multiple real providers can map to the same anonymous provider
HIDDEN_PROVIDERS=""

# Model Family Mapping (appended before hardcoded rules, higher priority)
# Format: target:pattern,target2:pattern2
#   - target = normalized model name
#   - pattern = match pattern, * suffix means prefix match
# Example: MODEL_RULES="k2p6:kimi-k2.6*,gpt-4o:gpt-4o*"
MODEL_RULES=""
