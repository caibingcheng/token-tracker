# === 必需 ===
SQLITE_DATABASE_PATH="./data/token-tracker.db"
GATEWAY_SECRET=""            # openssl rand -hex 32

# === 可选：bootstrap ===
# ADMIN_API_KEY 未配置且 DB 无 key 时，Web 端会出现首次设置向导
# ADMIN_API_KEY="your-key"   # 旧名 API_KEYS 仍兼容（deprecated）

# === 可选：也可在 admin panel 配置（面板优先，env 仅 fallback） ===
# HIDDEN_PROVIDERS="..."
# SESSION_TOKEN_TTL_HOURS=24
