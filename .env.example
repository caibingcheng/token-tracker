# SQLite Database
SQLITE_DATABASE_PATH="./data/token-tracker.db"

# API Keys (comma separated)
API_KEYS="your-api-key-here"

# AI Gateway master key (AES-256-GCM, hex/base64 encoded 32 bytes; REQUIRED for gateway)
# Generate with: openssl rand -hex 32
GATEWAY_SECRET=""

# Model Registry (optional; auto-created if missing)
# MODEL_REGISTRY_PATH="./data/model-registry.json"

# Provider Anonymization
# Legacy format (exact match, comma-separated):
#   HIDDEN_PROVIDERS="openai,anthropic"
#   → Maps to "Provider A", "Provider B" ...
#
# Anonymous grouped format (wildcard match, semicolon-separated groups):
#   HIDDEN_PROVIDERS="name1*,name2*;name3,name4*"
#   - Semicolons separate groups (Provider A, B, C...)
#   - Commas separate patterns within a group
#   - Asterisk suffix means prefix match
#   - Multiple real providers can map to the same anonymous provider
#
# Named grouped format (custom display name per group):
#   HIDDEN_PROVIDERS="CustomA:vendor,vendor-partner;CustomB:vendor-platform"
#   - Colon separates the custom display name from its patterns
#   - Semicolons separate different named groups
#   - Commas separate patterns within a group
#   - Asterisk suffix means prefix match
#   - Multiple real providers can map to the same named group
HIDDEN_PROVIDERS=""

# Query Cache (SQLite driver-level)
# API_CACHE_TTL_MS controls how long SELECT results are cached (ms). Default 10000 (10s). Set 0 to disable.
API_CACHE_TTL_MS=10000
# API_CACHE_MAX_SIZE controls max cache entries. Default 1000.
API_CACHE_MAX_SIZE=1000
# API_CACHE_DEBUG=true enables cache hit/miss logs for debugging.
# API_CACHE_DEBUG=true
