# Dependencies
node_modules/

# Next.js
.next/
# Next 自动生成，内容属实现细节（next dev 写 .next/dev/types，next build 写 .next/types）
next-env.d.ts

# Environment variables（各种变体；保留模板文件）
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Secrets / credentials / keys / certificates（永不入库）
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
credentials
credentials.*
*credentials.json
*credential.json
secrets
secrets.*
secret.*
*.secret
.npmrc

# Docker compose (use example file)
docker-compose.yml

# Drizzle
drizzle/

# OS
.DS_Store

# IDE
.vscode/
.idea/
*.tsbuildinfo

# Data
/data/
*.db
# dev 自动生成的主密钥（默认在 data/ 下已覆盖，自定义 SQLITE_DATABASE_PATH 时靠这条）
**/.gateway-secret

# OpenCode
.opencode/

# Docs (plan/spec)
/docs/*
!/docs/agents/
!/docs/architecture.md
!/docs/development.md
!/docs/screenshots.md
!/docs/security.md
/specs/

# Local dev tooling
mise.toml

# 本地性能基准脚手架：只保留脚本，数据/输出不入库
/bench/data/
/bench/out/
/bench/docker-data/
/bench/e2e-data/
/bench/.state/
**/bench/*.db
**/bench/*.db-wal
**/bench/*.db-shm
